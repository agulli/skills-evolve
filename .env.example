# Copy to `.env` and fill in. `.env` is gitignored; this template is NOT — so
# never put real keys here. The simulator reads these from the process
# environment - load them with:
#     set -a; . ./.env; set +a
# then run e.g. `python3 -m simulator.measure --model gemini --runs 3`.

# --- Gemini (Layer B, via google-genai SDK) ---
GEMINI_API_KEY=
# Flash-lite id. NB there is no gemini-3.5-flash-lite; use the alias or 3.1:
GEMINI_MODEL=gemini-flash-lite-latest

# --- Haiku (Layer B, via the Anthropic API) ---
# Optional: the API path needs this key. If you don't have one, drive Haiku via
# the Claude Code CLI instead (`claude -p --model haiku`, no key) - the way
# Culture Engineering did it.
ANTHROPIC_API_KEY=
HAIKU_MODEL=claude-haiku-4-5
